{
  "additionalProperties": false,
  "description": "A dataset row (one JSONL line).",
  "properties": {
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "input": {
      "additionalProperties": true,
      "title": "Input",
      "type": "object"
    },
    "expected": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "meta": {
      "additionalProperties": true,
      "title": "Meta",
      "type": "object"
    }
  },
  "required": [
    "id",
    "split",
    "input"
  ],
  "title": "evalgate.dataset_row.v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ROBERTG99/evalgate/schemas/evalgate.dataset_row.v1.json"
}
