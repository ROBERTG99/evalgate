{
  "$defs": {
    "BudgetSpec": {
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_p95_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max P95 Ms"
        }
      },
      "title": "BudgetSpec",
      "type": "object"
    },
    "HttpTargetSpec": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "method": {
          "default": "POST",
          "enum": [
            "GET",
            "POST",
            "PUT"
          ],
          "title": "Method",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "timeout_s": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "url"
      ],
      "title": "HttpTargetSpec",
      "type": "object"
    },
    "MetricSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "exact",
            "json_schema",
            "numeric_tolerance",
            "tool_calls",
            "contains_all",
            "regex",
            "judge",
            "custom"
          ],
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "direction": {
          "default": "higher",
          "enum": [
            "higher",
            "lower"
          ],
          "title": "Direction",
          "type": "string"
        },
        "gate": {
          "default": true,
          "title": "Gate",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "MetricSpec",
      "type": "object"
    },
    "TargetSpec": {
      "additionalProperties": false,
      "description": "Exactly one of ``python``, ``http`` or ``langgraph``.",
      "properties": {
        "python": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][\\w.]*:[A-Za-z_]\\w*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python"
        },
        "http": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpTargetSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "langgraph": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][\\w.]*:[A-Za-z_]\\w*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Langgraph"
        }
      },
      "title": "TargetSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "evalgate.suite.v1",
      "title": "Schema",
      "type": "string"
    },
    "name": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "dataset": {
      "minLength": 1,
      "title": "Dataset",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/TargetSpec"
    },
    "concurrency": {
      "default": 8,
      "maximum": 256,
      "minimum": 1,
      "title": "Concurrency",
      "type": "integer"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricSpec"
      },
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/BudgetSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "splits": {
      "items": {
        "enum": [
          "dev",
          "test"
        ],
        "type": "string"
      },
      "title": "Splits",
      "type": "array"
    },
    "plugins": {
      "description": "Modules imported before the run to register custom metrics.",
      "items": {
        "type": "string"
      },
      "title": "Plugins",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "name",
    "dataset",
    "target",
    "metrics"
  ],
  "title": "evalgate.suite.v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ROBERTG99/evalgate/schemas/evalgate.suite.v1.json"
}
