    "key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key",
      "type": "string"
    },
    "route": {
      "title": "Route",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "response": {
      "additionalProperties": true,
      "title": "Response",
      "type": "object"
    },
    "usage": {
      "$ref": "#/$defs/CassetteUsage"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    }
