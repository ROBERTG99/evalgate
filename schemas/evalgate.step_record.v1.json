{
  "additionalProperties": false,
  "description": "One step of a target or judge call; the record shared across the portfolio.",
  "properties": {
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "default": "",
      "title": "Task Id",
      "type": "string"
    },
    "step": {
      "default": 0,
      "minimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "node": {
      "default": "target",
      "title": "Node",
      "type": "string"
    },
    "kind": {
      "default": "other",
      "enum": [
        "llm",
        "tool",
        "retrieval",
        "judge",
        "target",
        "other"
      ],
      "title": "Kind",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "input_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "cost_usd": {
      "default": 0.0,
      "minimum": 0,
      "title": "Cost Usd",
      "type": "number"
    },
    "latency_ms": {
      "default": 0.0,
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "error",
        "timeout",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    }
  },
  "title": "evalgate.step_record.v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ROBERTG99/evalgate/schemas/evalgate.step_record.v1.json"
}
