{
  "uid": "evalgate",
  "title": "evalgate",
  "tags": [
    "evalgate"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gate decisions (by decision)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (increase(evalgate_gate_decisions_total[1h]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last gate decision per suite (1 = pass)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "evalgate_gate_last_decision",
          "legendFormat": "{{suite}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Case latency p95 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, suite) (rate(evalgate_case_latency_ms_bucket[15m])))",
          "legendFormat": "{{suite}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Eval cost (USD per hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(evalgate_cost_usd_total[1h]))",
          "legendFormat": "cost"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens by model",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(evalgate_tokens_total[1h]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Judge cache hit rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(evalgate_cache_hits_total[1h])) / clamp_min(sum(increase(evalgate_judge_calls_total[1h])), 1)",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Toy target requests by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint, status) (rate(toy_requests_total[5m]))",
          "legendFormat": "{{endpoint}} {{status}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
