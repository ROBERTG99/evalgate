# evalgate environment. Copy to .env (make bootstrap does it). Never commit real keys.

# Shared portfolio variables
DEMO_MODE=offline
LIVE_EVAL_BUDGET_USD=2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_REGION=us-east-1
LANGFUSE_HOST=http://localhost:8193
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# evalgate
EVALGATE_HOME=.evalgate
EVALGATE_BOOTSTRAP_SEED=1337
EVALGATE_CASE_TIMEOUT_S=60
EVALGATE_RUN_TIMEOUT_S=1800
EVALGATE_TARGET_RETRIES=2
EVALGATE_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,toy-targets
EVALGATE_TOYS_URL=http://localhost:8110
EVALGATE_LLM_PROVIDER=fake
EVALGATE_JUDGE_MODEL=claude-haiku-5-5
EVALGATE_JUDGE_HARD_MODEL=claude-opus-5-5
EVALGATE_JUDGE_CONCURRENCY=4
EVALGATE_JUDGE_TIMEOUT_S=60
EVALGATE_CACHE_TTL_DAYS=90
EVALGATE_SERVE_TOKEN=
EVALGATE_VIEWER_URL=http://localhost:8100
EVALGATE_RECORD_CASSETTES=0
